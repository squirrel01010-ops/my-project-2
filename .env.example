# Discord Developer Portal > Application > Bot
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Server owner is always an administrator; comma-separated extra user IDs.
ADMIN_USER_IDS=
# Must exactly match OAuth2 redirect origin (without trailing slash).
PUBLIC_URL=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080
# Optional bootstrap/local admin token. Generate a random value, never commit it.
ADMIN_TOKEN=
# Relative paths resolve from the project directory for both web and bot.
# Separate hosting services must share the same persistent database volume.
DB_PATH=bot.db
BACKUP_DIR=backups

